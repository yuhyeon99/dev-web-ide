SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:mysql://database-1.cif2g02ggeeo.us-east-1.rds.amazonaws.com:3306/dev_web_ide
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=

APP_JWT_SECRET=
APP_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
APP_PROJECT_STORAGE_ROOT=/app/storage
APP_STORAGE_PROJECT_ROOT=/app/storage
APP_CORS_ALLOWED_ORIGINS=https://d1qcnjd8lnakb.cloudfront.net,http://dev-web-ide-fe-prod-apne2.s3-website-ap-southeast-2.amazonaws.com

# Google OAuth 설정
# Google Cloud Console의 승인된 리디렉션 URI에도 같은 값을 등록해야 합니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://d15mkrht7zfcoy.cloudfront.net/api/auth/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT_URI=https://d1qcnjd8lnakb.cloudfront.net

# Redis 실시간 동기화 설정
# ElastiCache Redis 생성 전에는 false로 둡니다.
APP_REDIS_ENABLED=false
APP_REDIS_PROJECT_EVENTS_CHANNEL=dev-web-ide:project-events
APP_REDIS_CRDT_UPDATES_CHANNEL=dev-web-ide:crdt-updates
APP_REDIS_CHAT_MESSAGES_CHANNEL=dev-web-ide:chat-messages
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_TIMEOUT=2s

# RDS에 테이블이 아직 없으면 첫 배포 확인 때는 update를 사용합니다.
# 스키마가 안정화된 뒤에는 validate 사용을 권장합니다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
